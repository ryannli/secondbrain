{
  "manifest_version": 3,
  "name": "Second Brain Capture",
  "version": "1.3",
  "description": "Capture any page to Second Brain",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "action": {
    "default_title": "Capture to Second Brain"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*"],
      "js": ["twitter-autocapture.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
